# Copy this file to .env.cases and keep .env.cases out of git.
# This file is used only by: npm run sync:notion:cases
NOTION_TOKEN=secret_xxx
NOTION_CASES_DATABASE_ID=your_cases_database_id_or_url

NOTION_SYNC_STATUS_PROPERTY=同步状态
NOTION_SYNC_WRITEBACK=1
NOTION_TIMEOUT_MS=30000
NOTION_ASSET_TIMEOUT_MS=60000
