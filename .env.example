# Optional common defaults shared by both sync commands.
# Main workflow:
# - Copy .env.brands.example to .env.brands for Brands sync.
# - Copy .env.cases.example to .env.cases for Cases sync.

# Optional. The default matches your database.
NOTION_SYNC_STATUS_PROPERTY=同步状态

# Optional. Set to 0 if you want to update website files but not mark Notion rows as 已同步.
NOTION_SYNC_WRITEBACK=1

# Optional timeout settings in milliseconds.
NOTION_TIMEOUT_MS=30000
NOTION_ASSET_TIMEOUT_MS=60000
